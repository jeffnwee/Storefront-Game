{
  "rules": {
    ".read": false,
    ".write": false,
    "sessions": {
      "$gameId": {
        ".read": "auth != null && $gameId.matches(/^[0-9]{4}$/)",
        ".write": "auth != null && $gameId.matches(/^[0-9]{4}$/)",
        "status": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "mode": { ".validate": "newData.val() == null || newData.val() == 'solo' || newData.val() == 'multiplayer'" },
        "winner": { ".validate": "newData.val() == null || newData.val() == 'players' || newData.val() == 'monster'" },
        "log": { "$i": { ".validate": "newData.isString() && newData.val().length <= 200" } },
        "$other": { ".validate": true }
      }
    }
  }
}